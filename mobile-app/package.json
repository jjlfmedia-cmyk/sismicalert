{
  "name": "sismoalerta-america",
  "version": "1.0.0",
  "description": "Alertas sísmicas en tiempo real para América. Gratis. Sin anuncios.",
  "main": "src/js/app.js",
  "scripts": {
    "build": "npm run copy && npx cap sync android",
    "copy": "mkdir -p dist && cp -r src/* dist/",
    "dev": "npx http-server src -p 3001",
    "android:build": "npx cap build android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/motion": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capawesome/capacitor-torch": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "http-server": "^14.1.1"
  },
  "author": "JJLF Media <jjlfmedia@gmail.com>",
  "license": "MIT"
}
